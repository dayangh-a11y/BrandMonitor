# =============================================================================
# DEMO / PUBLIC PREVIEW — Prediction API on Render
# =============================================================================
# This block is for the FIRST public DEMO only.
# Fixture paths are TEST/DEMO data — NOT real production race cards.
# Do NOT invent or replace them with fabricated "real-world" schedules.
# =============================================================================

# Comma-separated frontend origins (Vercel / GitHub Pages / custom domain)
API_CORS_ORIGINS=https://YOUR-FRONTEND-HOST.example.com
API_CORS_ALLOW_CREDENTIALS=false

# --- DEMO/TEST dataset (explicit fixture mode) ---
# Required while the canonical freeze file is unavailable.
PREDICTION_DATASET_PATH=tests/fixtures/prediction_api/observations_fixture.jsonl.gz
PREDICTION_FREEZE_PATH=data/prediction_foundation/freezes/LATEST.json
PREDICTION_VERIFY_FREEZE=false
PREDICTION_DEFAULT_BASELINE=A
HORSE_NAME_INDEX_PATH=tests/fixtures/prediction_api/horse_names.json

# DEMO/TEST future race program (materialize near-future times before deploy):
#   python3 tests/fixtures/race_program/build.py
RACE_PROGRAM_PATH=tests/fixtures/race_program/program_fixture.json

