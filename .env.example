# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=45000
BROWSER_NAVIGATION_TIMEOUT_MS=45000
MAX_RETRIES=3
RETRY_WAIT_SECONDS=2

# Output
OUTPUT_DIR=output
LOG_DIR=logs
LOG_LEVEL=INFO

# PostgreSQL (optional for phase 1 file export)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/horse_racing
DATABASE_ECHO=false

# Mass crawler
CRAWL_SEED_URL=https://asbdavani.app/racecards
CRAWL_DELAY_SECONDS=1.5
CRAWL_WORKERS=2
CRAWL_MAX_ATTEMPTS=3
CRAWL_COLLECT_HISTORIES=false
CRAWL_STALE_RUNNING_SECONDS=3600
# Racecourse scope (expandable). Codes: gonbad-kavous, aq-qala, bandar-torkaman
# Do not set "*" unless you intentionally want nationwide crawl.
CRAWL_ALLOWED_RACECOURSES=gonbad-kavous,aq-qala,bandar-torkaman

# Historical weather (Open-Meteo Archive; no API key)
WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_DEFAULT_RACE_HOUR=14
WEATHER_LOOKBACK_DAYS=7
WEATHER_PARSER_VERSION=1.0.0

# Prediction HTTP API (freeze-backed baselines — SCORE/RANK only)
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_CORS_ALLOW_CREDENTIALS=false
PREDICTION_DATASET_PATH=data/prediction_foundation/datasets/observations.jsonl.gz
PREDICTION_FREEZE_PATH=data/prediction_foundation/freezes/LATEST.json
PREDICTION_VERIFY_FREEZE=true
PREDICTION_DEFAULT_BASELINE=A
