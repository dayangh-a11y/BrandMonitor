# =============================================================================
# Frontend — public Demo / production static build
# =============================================================================
# REQUIRED for production builds (baked in at build time by Vite).
# Do NOT leave this as localhost for a public Demo.
VITE_API_BASE_URL=https://YOUR-RENDER-API-HOST.onrender.com

# Static asset base path:
#   "/"                 → Vercel / custom domain root
#   "/BrandMonitor/"    → GitHub Pages project site
VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# Local development only (never use in public Demo build):
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_BASE_PATH=/
# -----------------------------------------------------------------------------
